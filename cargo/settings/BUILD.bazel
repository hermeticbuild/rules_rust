load("@bazel_lib//:bzl_library.bzl", doc_extract_bzl_library = "bzl_library")
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(
    ":settings.bzl",
    "cargo_manifest_dir_filename_suffixes_to_retain",
    "debug_std_streams_output_group",
    "experimental_symlink_execroot",
    "out_dir_volatile_file_basenames",
    "use_default_shell_env",
)

package(default_visibility = ["//visibility:public"])

exports_files(["settings.bzl"])

bzl_library(
    name = "bzl_lib",
    srcs = glob(["*.bzl"]),
    visibility = ["//cargo:__pkg__"],
    deps = [
        "@bazel_skylib//rules:common_settings",
    ],
)

doc_extract_bzl_library(
    name = "doc_extract_tests",
    testonly = True,
    srcs = glob(["*.bzl"]),
    deps = [":bzl_lib"],
)

cargo_manifest_dir_filename_suffixes_to_retain()

debug_std_streams_output_group()

experimental_symlink_execroot()

use_default_shell_env()

config_setting(
    name = "use_exec_features_enabled",
    values = {"features": "rules_rust_use_exec_features"},
)

out_dir_volatile_file_basenames()
