load("//cargo:defs.bzl", "cargo_build_script")
load("//rust:defs.bzl", "rust_test")

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    edition = "2021",
)

rust_test(
    name = "test",
    srcs = ["test.rs"],
    data = [":build_script"],
    edition = "2021",
    env = {"BUILD_SCRIPT_OUT_DIR": "$(rlocationpath :build_script)"},
    deps = [
        ":build_script",
        "//rust/runfiles",
    ],
)
